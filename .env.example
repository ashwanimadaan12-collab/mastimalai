# ---- Masti Malai OTT — environment template ----
# Copy to services/api/.env and apps/web/.env.local as noted. Never commit real secrets.

# ===== Backend (services/api/.env) =====
DATABASE_URL="postgresql://localhost:5432/masti_malai?schema=public"
NODE_ENV=development
API_PORT=4000

# Auth
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# OTP (dev). When true, the OTP is returned in the API response so you can log in without an SMS provider.
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300

# Optional Redis (leave blank to use in-memory fallback)
REDIS_URL=""

# Playback token
PLAYBACK_TOKEN_SECRET="dev-playback-secret-change-me"
PLAYBACK_TOKEN_TTL_SECONDS=21600

# Local storage / streaming (no S3/CDN in dev)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./storage-dev"
API_PUBLIC_URL="http://localhost:4000"
STREAM_CACHE_DIR="./storage-dev/hls-cache"
STREAM_UPSTREAM_HOSTS="test-streams.mux.dev,devstreaming-cdn.apple.com,stream.mux.com"

# Transcoder (ffmpeg). Leave blank to use whatever is on PATH.
FFMPEG_PATH=""
FFPROBE_PATH=""
UPLOAD_MAX_BYTES=2000000000

# Payments — LOCAL SANDBOX ONLY (no real Razorpay). Do not use in production.
PAYMENTS_DRIVER=local-sandbox

# ===== Web (apps/web/.env.local) =====
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
