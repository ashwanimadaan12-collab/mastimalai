# ---- Masti Malai — PRODUCTION env (copy to .env.production; NEVER commit real values) ----
# Generate fresh secrets with:  node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'

# Database (compose creates this Postgres on the same EC2 box)
POSTGRES_PASSWORD=change-me-strong-db-password

# Auth / signing secrets — REPLACE all four with unique random strings
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
ADMIN_JWT_SECRET=replace-me
PLAYBACK_TOKEN_SECRET=replace-me

# First admin (created on first boot). Change the password after first login.
ADMIN_SEED_EMAIL=admin@yourdomain.com
ADMIN_SEED_PASSWORD=replace-me-strong

# === SECURITY-CRITICAL SWITCHES ===
# OTP delivery. false = OTP is NOT returned in the API response (secure).
#   Keep false in production. true = DEV ONLY (returns OTP; enables takeover).
OTP_DEV_MODE=false

# Payments. 'local-sandbox' does NOT take real money and approves every payment
# (test only). Switch to Razorpay before charging real customers.
PAYMENTS_DRIVER=local-sandbox

# ---- Domains (all four point at THIS EC2's public IP via A records) ----
# Root + www serve the consumer site; api. and admin. serve those apps.
ROOT_DOMAIN=yourdomain.com
WEB_DOMAIN=www.yourdomain.com
API_DOMAIN=api.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com

# Public URLs derived from the domains above (used by the API + baked into the
# web/admin client bundles at build time). Keep these in sync with the domains.
API_PUBLIC_URL=https://api.yourdomain.com
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
ADMIN_CORS_ORIGIN=https://admin.yourdomain.com
